{
  "name": "gerafe",
  "private": true,
  "version": "0.1.1",
  "description": "A local-first genomic renderer and figure editor.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariel-raskin/GeRAFE.git"
  },
  "bugs": {
    "url": "https://github.com/ariel-raskin/GeRAFE/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:bundle": "tauri build --bundles nsis",
    "desktop:check-setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows.ps1 -CheckOnly",
    "desktop:install-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "version:check": "node scripts/version.mjs --check",
    "version:print": "node scripts/version.mjs --print",
    "version:set": "node scripts/version.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke-browser.mjs",
    "benchmark:data": "node scripts/benchmark-bigwig.mjs",
    "reference:cytobands": "node scripts/update-cytobands.mjs",
    "reference:genes": "node scripts/build-refseq-transcripts.mjs"
  },
  "dependencies": {
    "@gmod/bam": "^9.0.1",
    "@gmod/bbi": "^11.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "generic-filehandle2": "^2.4.0",
    "pako-esm2": "^2.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
